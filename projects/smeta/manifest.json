{
  "version": "3.0",
  "name": "smeta",
  "description": "Инфраструктура для составления смет по ФЕР-2020/БИМ-методике",
  "created": "2026-06-28",
  "updated": "2026-06-29",
  "schema": "BIM + FER-2020 + Methodology 2 + Order 421/pr",
  "paths": {
    "src": "src/",
    "templates": "templates/",
    "data": "data/",
    "docs": "docs/",
    "raw": "raw/",
    "config": "config/"
  },
  "cron": {
    "check_updates": "0 9 1 * *"
  },
  "dependencies": [
    "openpyxl>=3.0.0"
  ],
  "rules": [
    "ВОР = единственный источник объёмов",
    "Индексы по статьям (ОТ, ЭМ, М), не общий",
    "НР/СП от ФОТ, не от прямых",
    "Поправки с разными коэфф. по статьям",
    "ФССЦ для материалов отдельно"
  ]
}